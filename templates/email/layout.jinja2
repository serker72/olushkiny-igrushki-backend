8V18.4ZM115.965 28L120.381 10.48H124.245L128.685 28H125.613L124.653 23.752H119.997L119.037 28H115.965ZM120.549 21.304H124.101L123.045 16.6C122.869 15.816 122.717 15.112 122.589 14.488C122.461 13.848 122.373 13.384 122.325 13.096C122.277 13.384 122.189 13.848 122.061 14.488C121.949 15.112 121.797 15.808 121.605 16.576L120.549 21.304ZM131.436 28V10.48H142.332V13.264H134.388V17.944H141.708V20.728H134.436V28H131.436ZM149.594 28V13.264H145.01V10.48H157.202V13.264H152.618V28H149.594Z"
                  fill="#58A6FF"/>
        </svg>

        {% block header %}{% endblock %}
    </div>

    <div class="message">
        {% block message %}{% endblock %}
    </div>

    <div class="buttons">
        {% block buttons %}{% endblock %}
    </div>

    <div class="footer">
        <div class="footer-line"></div>
        <div class="footer-text">
            С уважением,<br/>
            Команда проекта
        </div>
    </div>
</div>
</body>
</html>
